# Copy to .env and adjust. Only WEBHOOK_URL needs to change to point at a real receiver.

# --- Webhook receiver used by the seeded subscriptions ---
# Local default: WireMock inside the Compose network (HTTP allowed only in the local profile).
WEBHOOK_URL=http://wiremock:8080/webhook
# Comma-separated allowlist of hosts the worker may call over plain HTTP or private IPs (local profile only).
WEBHOOK_ALLOWLIST=wiremock

# --- Event simulator ---
SIMULATOR_EMIT_INTERVAL_MS=2000
SIMULATOR_EMIT_REFERENCE_ON_START=true

# --- PostgreSQL ---
POSTGRES_DB=notifications
POSTGRES_USER=notifications
POSTGRES_PASSWORD=notifications
POSTGRES_PORT=5432

# --- ElasticMQ (SQS API) ---
SQS_ENDPOINT=http://elasticmq:9324
SQS_QUEUE_NAME=account-events
SQS_REGION=us-east-1
# Any value works against ElasticMQ.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Ports published on the host ---
API_PORT=8080
SIMULATOR_PORT=8090
WIREMOCK_PORT=8089
ELASTICMQ_UI_PORT=9325
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# --- JWT (RS256). Keys are generated by `make keys` into deploy/local/keys/; the path below is inside the container ---
JWT_PUBLIC_KEY_PATH=/keys/jwt-public.pem
JWT_AUDIENCE=account-event-notification
JWT_CLIENT_CLAIM=sub
